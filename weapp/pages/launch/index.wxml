<view class="page">
  <view class="orb orb-one"></view>
  <view class="orb orb-two"></view>

  <view class="hero-card">
    <view class="brand-row">
      <view class="brand-mark">P</view>
      <view>
        <view class="brand-title">Puppy</view>
        <view class="brand-subtitle">专属陪伴账号</view>
      </view>
    </view>

    <view class="visual-wrap">
      <image
        class="hero-visual"
        src="/images/6350cb0e8a48e1bd62c0a75c71de0cd1 1.svg"
        mode="aspectFit"
      />
    </view>

    <view class="title">欢迎来到 Puppy</view>
    <view class="subtitle">
      一键登录后，Puppy 会记住你的专属档案、兴趣和陪伴记忆。
    </view>

    <button
      class="login-btn"
      bindtap="onOneTapLogin"
      loading="{{loggingIn}}"
      disabled="{{loggingIn || savingAvatar}}"
    >
      {{loggingIn ? "登录中..." : "一键登录"}}
    </button>

    <view class="error-text" wx:if="{{errorText}}">
      {{errorText}}
    </view>
  </view>

  <view
    wx:if="{{showAvatarSheet}}"
    class="sheet-mask"
    bindtap="onCloseAvatarSheet"
  >
    <view class="avatar-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title">选择头像</view>
      <view class="sheet-subtitle">首次登录需要先设置一个头像，之后会自动使用已绑定微信号登录。</view>

      <view class="sheet-option-list">
        <button
          class="sheet-option sheet-option-primary"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
          loading="{{savingAvatar}}"
          disabled="{{savingAvatar}}"
        >
          <image
            wx:if="{{avatarUrl}}"
            class="sheet-option-avatar"
            src="{{avatarUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="sheet-option-avatar sheet-option-avatar-placeholder">微信</view>
          <view class="sheet-option-text">用微信头像</view>
        </button>

        <button
          class="sheet-option"
          bindtap="onPickAlbumAvatar"
          loading="{{savingAvatar}}"
          disabled="{{savingAvatar}}"
        >
          <view class="sheet-option-icon">相</view>
          <view class="sheet-option-text">从相册选择</view>
        </button>

        <button
          class="sheet-option"
          bindtap="onTakePhotoAvatar"
          loading="{{savingAvatar}}"
          disabled="{{savingAvatar}}"
        >
          <view class="sheet-option-icon">拍</view>
          <view class="sheet-option-text">拍照</view>
        </button>
      </view>

      <button
        class="sheet-cancel-btn"
        disabled="{{savingAvatar}}"
        bindtap="onCloseAvatarSheet"
      >
        稍后再说
      </button>
    </view>
  </view>
</view>
