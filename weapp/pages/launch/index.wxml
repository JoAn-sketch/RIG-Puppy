<view class="page">
  <view class="orb orb-one"></view>
  <view class="orb orb-two"></view>

  <view class="hero-card">
    <view class="brand-row">
      <view class="brand-mark">P</view>
      <view>
        <view class="brand-title">Puppy</view>
        <view class="brand-subtitle">专属陪伴账号</view>
      </view>
    </view>

    <view class="visual-wrap">
      <image
        class="hero-visual"
        src="/images/6350cb0e8a48e1bd62c0a75c71de0cd1 1.svg"
        mode="aspectFit"
      />
    </view>

    <view class="title">欢迎来到 Puppy</view>
    <view class="subtitle">
      先确认微信身份，再继续进入今天的 Puppy 体验。
    </view>

    <button
      wx:if="{{!loggingIn && !needsAvatar}}"
      class="login-btn"
      bindtap="onOneTapLogin"
    >
      一键登录
    </button>

    <button
      wx:elif="{{!loggingIn && needsAvatar}}"
      class="login-btn"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
    >
      使用微信头像
    </button>

    <button
      wx:else
      class="login-btn"
      loading="{{true}}"
      disabled="{{true}}"
    >
      登录中...
    </button>

    <view class="error-text" wx:if="{{errorText}}">
      {{errorText}}
    </view>
  </view>

</view>
