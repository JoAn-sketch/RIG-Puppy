.page {
  position: relative;
  min-height: 100vh;
  padding: 42rpx 30rpx;
  overflow: hidden;
  background: #f8b421;
  box-sizing: border-box;
}

.orb {
  position: absolute;
  border-radius: 999rpx;
  opacity: 0.36;
}

.orb-one {
  top: -120rpx;
  right: -100rpx;
  width: 340rpx;
  height: 340rpx;
  background: #fff1b8;
}

.orb-two {
  left: -130rpx;
  bottom: 160rpx;
  width: 300rpx;
  height: 300rpx;
  background: #d77d32;
}

.hero-card {
  position: relative;
  z-index: 1;
  min-height: calc(100vh - 84rpx);
  padding: 34rpx 30rpx 42rpx;
  border-radius: 38rpx;
  background: #fff9ef;
  box-shadow: 0 24rpx 54rpx rgba(122, 77, 10, 0.14);
  box-sizing: border-box;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-mark {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: #5a281c;
  color: #ffd254;
  font-size: 36rpx;
  line-height: 68rpx;
  text-align: center;
  font-weight: 800;
}

.brand-title {
  color: #2f241f;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
}

.brand-subtitle {
  margin-top: 4rpx;
  color: #936f4a;
  font-size: 22rpx;
}

.visual-wrap {
  margin: 68rpx auto 42rpx;
  width: 500rpx;
  height: 390rpx;
  border-radius: 40rpx;
  background: linear-gradient(180deg, #ffe6a3 0%, #fff8dd 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 -14rpx 30rpx rgba(152, 91, 8, 0.08);
}

.hero-visual {
  width: 440rpx;
  height: 340rpx;
}

.title {
  color: #2f241f;
  font-size: 50rpx;
  line-height: 1.25;
  font-weight: 800;
  text-align: center;
}

.subtitle {
  margin: 18rpx auto 0;
  max-width: 560rpx;
  color: #6b5540;
  font-size: 27rpx;
  line-height: 1.58;
  text-align: center;
}

.login-btn {
  margin-top: 58rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  background: #5a281c;
  color: #ffd254;
  font-size: 32rpx;
  font-weight: 800;
  box-shadow: 0 16rpx 30rpx rgba(90, 40, 28, 0.2);
}

.error-text {
  margin-top: 22rpx;
  color: #b53d2e;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}
