.container {
  padding: 32rpx;
}

.card {
  background: linear-gradient(180deg, #fffdf9 0%, #fff7ee 100%);
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 18rpx 48rpx rgba(130, 93, 54, 0.08);
  border: 2rpx solid rgba(173, 126, 73, 0.12);
}

.hero {
  margin-bottom: 36rpx;
}

.eyebrow {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #9a6d43;
  margin-bottom: 12rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
  color: #2f241f;
}

.title-row {
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.profile-avatar {
  width: 82rpx;
  height: 82rpx;
  border-radius: 28rpx;
  border: 2rpx solid #ead8c6;
  box-shadow: 0 10rpx 22rpx rgba(130, 93, 54, 0.12);
  flex-shrink: 0;
}

.subtitle {
  font-size: 26rpx;
  line-height: 1.6;
  color: #6a5547;
}

.profile-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.profile-item {
  background: #fff;
  border: 2rpx solid #ead8c6;
  border-radius: 22rpx;
  padding: 22rpx 24rpx;
}

.label {
  font-size: 24rpx;
  color: #8e7564;
  margin-bottom: 8rpx;
}

.value {
  font-size: 30rpx;
  color: #2f241f;
  font-weight: 600;
}

.device-value {
  font-size: 24rpx;
  word-break: break-all;
}

.empty-state {
  background: #fff;
  border: 2rpx dashed #ead8c6;
  border-radius: 22rpx;
  padding: 28rpx 24rpx;
  font-size: 26rpx;
  color: #7a6557;
  line-height: 1.7;
}

.error-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #b53d2e;
}

.back-link {
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9a6d43;
}

.device-link {
  margin-top: 18rpx;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 999rpx;
  text-align: center;
  background: #5a281c;
  color: #ffd254;
  font-size: 28rpx;
  font-weight: 700;
}
